{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:varvis:schema:evidence-context-v3",
  "title": "Varvis opt-in BS1 evidence context v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contextId",
    "canonicalizationProfile",
    "dataClass",
    "scope",
    "variant",
    "gene",
    "disease",
    "moi",
    "patientContext",
    "contextCompleteness"
  ],
  "properties": {
    "schemaVersion": {
      "const": "evidence-context-v3"
    },
    "contextId": {
      "type": "string",
      "pattern": "^context-sha256-[0-9a-f]{64}$"
    },
    "canonicalizationProfile": {
      "const": "varvis-json-c14n-v1"
    },
    "dataClass": {
      "enum": [
        "SYNTHETIC",
        "PRIVACY_BOUNDED_RUNTIME"
      ]
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "variant": {
      "$ref": "#/$defs/variantContext"
    },
    "gene": {
      "$ref": "#/$defs/gene"
    },
    "disease": {
      "$ref": "#/$defs/disease"
    },
    "moi": {
      "$ref": "urn:varvis:schema:common-definitions-v1#/$defs/moi"
    },
    "transcript": {
      "$ref": "#/$defs/transcript"
    },
    "patientContext": {
      "$ref": "#/$defs/patientContext"
    },
    "contextCompleteness": {
      "$ref": "#/$defs/contextCompleteness"
    }
  },
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analysisDomain",
        "diseaseModel",
        "variantScope"
      ],
      "properties": {
        "analysisDomain": {
          "const": "GERMLINE"
        },
        "diseaseModel": {
          "const": "MENDELIAN"
        },
        "variantScope": {
          "const": "SMALL_SEQUENCE_VARIANT"
        }
      }
    },
    "allele": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assembly",
        "contig",
        "position",
        "reference",
        "alternate"
      ],
      "properties": {
        "assembly": {
          "$ref": "urn:varvis:schema:common-definitions-v1#/$defs/assembly"
        },
        "contig": {
          "type": "string",
          "pattern": "^(?:[1-9]|1[0-9]|2[0-2]|X|Y)$"
        },
        "position": {
          "type": "integer",
          "minimum": 1
        },
        "reference": {
          "type": "string",
          "pattern": "^[ACGT]+$",
          "maxLength": 10000
        },
        "alternate": {
          "type": "string",
          "pattern": "^[ACGT]+$",
          "maxLength": 10000
        }
      }
    },
    "variantContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alleleId",
        "variantType",
        "inputAllele",
        "normalizedAllele",
        "evidenceQueryAllele",
        "normalization",
        "assemblyLineage"
      ],
      "properties": {
        "alleleId": {
          "type": "string",
          "pattern": "^allele-sha256-[0-9a-f]{64}$"
        },
        "legacyCanonicalVariantId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "variantType": {
          "enum": [
            "SNV",
            "MNV",
            "SMALL_INSERTION",
            "SMALL_DELETION",
            "SMALL_DELINS"
          ]
        },
        "inputAllele": {
          "$ref": "#/$defs/allele"
        },
        "normalizedAllele": {
          "$ref": "#/$defs/allele"
        },
        "evidenceQueryAllele": {
          "$ref": "#/$defs/allele"
        },
        "normalization": {
          "$ref": "#/$defs/normalization"
        },
        "assemblyLineage": {
          "$ref": "#/$defs/assemblyLineage"
        }
      }
    },
    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "method",
        "methodVersion",
        "referenceSequenceSha256",
        "refValidation"
      ],
      "properties": {
        "status": {
          "enum": [
            "UNCHANGED",
            "NORMALIZED"
          ]
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "methodVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "referenceSequenceSha256": {
          "$ref": "urn:varvis:schema:common-definitions-v1#/$defs/sha256"
        },
        "refValidation": {
          "const": "MATCH"
        }
      }
    },
    "assemblyLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mappingStatus"
      ],
      "properties": {
        "mappingStatus": {
          "enum": [
            "NATIVE",
            "MAPPED",
            "UNMAPPED",
            "REF_MISMATCH"
          ]
        },
        "coordinateMapping": {
          "$ref": "#/$defs/coordinateMapping"
        },
        "reasonCode": {
          "$ref": "urn:varvis:schema:common-definitions-v1#/$defs/reasonCode"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mappingStatus": {
                "const": "MAPPED"
              }
            },
            "required": [
              "mappingStatus"
            ]
          },
          "then": {
            "required": [
              "coordinateMapping"
            ]
          },
          "else": {
            "not": {
              "required": [
                "coordinateMapping"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "mappingStatus": {
                "enum": [
                  "UNMAPPED",
                  "REF_MISMATCH"
                ]
              }
            },
            "required": [
              "mappingStatus"
            ]
          },
          "then": {
            "required": [
              "reasonCode"
            ]
          }
        }
      ]
    },
    "coordinateMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceAllele",
        "targetAllele",
        "method",
        "methodVersion",
        "refAltValidation"
      ],
      "properties": {
        "sourceAllele": {
          "$ref": "#/$defs/allele"
        },
        "targetAllele": {
          "$ref": "#/$defs/allele"
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "methodVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "refAltValidation": {
          "const": "MATCH"
        }
      }
    },
    "gene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hgncId",
        "symbol"
      ],
      "properties": {
        "hgncId": {
          "type": "string",
          "pattern": "^HGNC:[1-9][0-9]*$"
        },
        "symbol": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "maxLength": 64
        }
      }
    },
    "disease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mondoId",
        "label"
      ],
      "properties": {
        "mondoId": {
          "type": "string",
          "pattern": "^MONDO:[0-9]{7}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "transcript": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accession",
        "version",
        "selectionPolicy",
        "annotationSourceVersion"
      ],
      "properties": {
        "accession": {
          "type": "string",
          "pattern": "^(?:(?:NM|NR)_[A-Za-z0-9]+|ENST[0-9]+)$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "selectionPolicy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "annotationSourceVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "patientContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "patientContextId",
        "role",
        "affectedStatus",
        "sex"
      ],
      "properties": {
        "patientContextId": {
          "type": "string",
          "pattern": "^patient-context-[a-z0-9][a-z0-9._-]{7,95}$"
        },
        "familyContextId": {
          "type": "string",
          "pattern": "^family-context-[a-z0-9][a-z0-9._-]{7,95}$"
        },
        "role": {
          "enum": [
            "PROBAND",
            "FAMILY_MEMBER"
          ]
        },
        "affectedStatus": {
          "enum": [
            "AFFECTED",
            "UNAFFECTED",
            "UNKNOWN"
          ]
        },
        "sex": {
          "enum": [
            "FEMALE",
            "MALE",
            "UNKNOWN"
          ]
        }
      }
    },
    "contextCompleteness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "missingFields"
      ],
      "properties": {
        "status": {
          "const": "COMPLETE"
        },
        "missingFields": {
          "type": "array",
          "items": {
            "enum": [
              "VARIANT_NORMALIZATION",
              "ASSEMBLY_LINEAGE",
              "HGNC_GENE",
              "MONDO_DISEASE",
              "MOI",
              "TRANSCRIPT_VERSION",
              "PATIENT_CONTEXT",
              "FAMILY_CONTEXT"
            ]
          },
          "maxItems": 0,
          "uniqueItems": true
        }
      }
    }
  }
}
