<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.nbscn.varvis.mapper.varvis.VariantGeneMapper">

    <resultMap id="geneDetailMap" type="org.nbscn.varvis.dto.variant.response.GeneDetailDTO">
        <result property="geneSymbol" column="gene_symbol"/>
        <result property="geneName" column="gene_name"/>
        <result property="geneId" column="gene_id"/>
        <result property="chromosome" column="chromosome"/>
    </resultMap>

    <resultMap id="geneCoordinateMap" type="org.nbscn.varvis.entity.variant.GeneCoordinateEntity">
        <result property="geneCoordinateId" column="gene_coordinate_id"/>
        <result property="geneId" column="gene_id"/>
        <result property="geneSymbol" column="gene_symbol"/>
        <result property="chromosome" column="chromosome"/>
        <result property="startBp" column="start_bp"/>
        <result property="endBp" column="end_bp"/>
        <result property="strand" column="strand"/>
        <result property="geneType" column="gene_type"/>
        <result property="gencodeGeneId" column="gencode_gene_id"/>
        <result property="sourceDb" column="source_db"/>
        <result property="sourceFile" column="source_file"/>
        <result property="isBasic" column="is_basic"/>
    </resultMap>

    <resultMap id="diseaseSummaryMap" type="org.nbscn.varvis.dto.variant.response.DiseaseSummaryDTO">
        <result property="diseaseId" column="disease_id"/>
        <result property="diseaseName" column="disease_name"/>
        <result property="diseaseNameCn" column="disease_name_cn"/>
        <result property="orphaNumber" column="orpha_number"/>
        <result property="omimId" column="omim_id"/>
        <result property="locus" column="locus"/>
        <result property="locusType" column="locus_type"/>
        <result property="bandId" column="band_id"/>
    </resultMap>

    <resultMap id="geneSummaryMap" type="org.nbscn.varvis.dto.variant.response.GeneSummaryDTO">
        <result property="geneSymbol" column="gene_symbol"/>
        <result property="geneName" column="gene_name"/>
        <result property="chromosome" column="chromosome"/>
        <result property="startBp" column="start_bp"/>
        <result property="endBp" column="end_bp"/>
        <result property="diseaseCount" column="disease_count"/>
    </resultMap>

    <resultMap id="geneCurationMap" type="org.nbscn.varvis.entity.variant.ClingenGeneCurationEntity">
        <result property="curationId" column="curation_id"/>
        <result property="geneId" column="gene_id"/>
        <result property="geneSymbol" column="gene_symbol"/>
        <result property="chromosome" column="chromosome"/>
        <result property="startBp" column="start_bp"/>
        <result property="endBp" column="end_bp"/>
        <result property="haploScore" column="haplo_score"/>
        <result property="triploScore" column="triplo_score"/>
        <result property="haploDescription" column="haplo_description"/>
        <result property="triploDescription" column="triplo_description"/>
        <result property="diseaseLabel" column="disease_label"/>
        <result property="omimIds" column="omim_ids"/>
        <result property="sourceFile" column="source_file"/>
    </resultMap>

    <select id="getGeneDetail" parameterType="java.lang.String" resultMap="geneDetailMap">
        SELECT g.gene_symbol,
               g.gene_symbol AS gene_name,
               g.gene_id,
               chr.chr_name AS chromosome
        FROM gene g
                 LEFT JOIN chromosome chr ON chr.chromosome_id = g.chromosome_id
        WHERE g.gene_symbol = #{geneSymbol}
        LIMIT 1
    </select>

    <select id="getGeneCoordinate" parameterType="java.lang.String" resultMap="geneCoordinateMap">
        SELECT gc.gene_coordinate_id,
               gc.gene_id,
               gc.gene_symbol,
               chr.chr_name AS chromosome,
               gc.start_bp,
               gc.end_bp,
               gc.strand,
               gc.gene_type,
               gc.gencode_gene_id,
               gc.source_db,
               gc.source_file,
               gc.is_basic
        FROM gene_coordinate gc
                 LEFT JOIN chromosome chr ON chr.chromosome_id = gc.chromosome_id
        WHERE gc.gene_symbol = #{geneSymbol}
        ORDER BY gc.is_basic DESC, gc.source_db, gc.gene_coordinate_id
        LIMIT 1
    </select>

    <select id="listDiseasesByGene" parameterType="java.lang.String" resultMap="diseaseSummaryMap">
        SELECT d.disease_id,
               d.disease_name,
               NULL AS disease_name_cn,
               d.orpha_code AS orpha_number,
               NULL AS omim_id,
               d.locus_text AS locus,
               d.locus_type,
               (
                   SELECT dbm.cytoband_id
                   FROM disease_band_map dbm
                   WHERE dbm.disease_id = d.disease_id
                   ORDER BY dbm.cytoband_id
                   LIMIT 1
               ) AS band_id
        FROM disease_gene_map dgm
                 JOIN gene g ON g.gene_id = dgm.gene_id
                 JOIN disease d ON d.disease_id = dgm.disease_id
        WHERE g.gene_symbol = #{geneSymbol}
        ORDER BY d.disease_name, d.disease_id
    </select>

    <select id="listGeneCuration" parameterType="java.lang.String" resultMap="geneCurationMap">
        SELECT curation.curation_id,
               curation.gene_id,
               curation.gene_symbol,
               chr.chr_name AS chromosome,
               curation.start_bp,
               curation.end_bp,
               curation.haplo_score,
               curation.triplo_score,
               curation.haplo_description,
               curation.triplo_description,
               curation.disease_label,
               curation.omim_ids,
               curation.source_file
        FROM clingen_gene_curation curation
                 LEFT JOIN chromosome chr ON chr.chromosome_id = curation.chromosome_id
        WHERE curation.gene_symbol = #{geneSymbol}
        ORDER BY curation.curation_id DESC
    </select>

    <select id="searchGenes" resultMap="geneSummaryMap">
        SELECT g.gene_symbol,
               g.gene_symbol AS gene_name,
               chr.chr_name AS chromosome,
               g.start_bp,
               g.end_bp,
               (
                   SELECT COUNT(DISTINCT dgm.disease_id)
                   FROM disease_gene_map dgm
                   WHERE dgm.gene_id = g.gene_id
               ) AS disease_count
        FROM gene g
                 LEFT JOIN chromosome chr ON chr.chromosome_id = g.chromosome_id
        WHERE g.gene_symbol LIKE CONCAT('%', #{keyword}, '%')
        ORDER BY g.gene_symbol
        LIMIT #{limit}
    </select>
</mapper>
